# Copie este archivo como .env y cambie los valores. El archivo .env NO se sube a GitHub.
PASTOREANDO_JWT_CLAVE=cambie-esta-clave-por-una-larga-y-aleatoria
PASTOREANDO_JWT_MINUTOS=60
# PASTOREANDO_BD=data/pastoreando.db
PASTOREANDO_CODIGO_PROFESIONAL=cambie-este-codigo-de-profesionales
# Motor de base de datos: sqlite (por defecto) o mysql.
# PASTOREANDO_MOTOR=mysql
# PASTOREANDO_MYSQL_HOST=127.0.0.1
# PASTOREANDO_MYSQL_PUERTO=3306
# PASTOREANDO_MYSQL_USUARIO=pastoreando
# PASTOREANDO_MYSQL_CLAVE=escriba-la-clave-de-su-usuario-mysql
# PASTOREANDO_MYSQL_BASE=pastoreando
# Certificado TLS del servidor (ruta o texto PEM), solo si el proveedor lo exige.
# PASTOREANDO_MYSQL_CA=
# Interfaz que sirve el servidor: por defecto la PWA de la carpeta frontend. Para servir
# React compilado (npm run build) use estas dos variables.
# PASTOREANDO_FRONTEND=frontend-react/dist
# PASTOREANDO_FRONTEND_SPA=1
