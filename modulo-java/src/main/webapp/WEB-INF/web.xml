<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Pastoreando - Gestion de lotes</display-name>

    <!-- Los servlets, el filtro y el listener se declaran con anotaciones (@WebServlet, @WebFilter, @WebListener). -->

    <!-- Pagina que se abre en http://localhost:8080/pastoreando/ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <!-- Minutos de inactividad antes de cerrar la sesion del propietario -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Errores tecnicos (por ejemplo, MySQL apagado) y errores HTTP comunes usan una sola pagina -->
    <error-page>
        <exception-type>co.pastoreando.excepcion.AccesoDatosException</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
</web-app>
